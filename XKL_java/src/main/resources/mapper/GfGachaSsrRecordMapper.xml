<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.example.xkl_java.mapper.GfGachaSsrRecordMapper">
    <insert id="insertGfGachaSsrRecordList">
        insert into gf_gacha_ssr_record(user_id, history_id, pool_type, item_id, draw_order, cost_draws)
        values
        <foreach collection="gfGachaSsrRecordList" item="record" separator=",">
            (#{record.userId}, #{record.historyId}, #{record.poolType}, #{record.itemId}, #{record.drawOrder}, #{record.costDraws})
        </foreach>
    </insert>
    <delete id="deleteGfGachaSsrRecordByUserId">
        delete from gf_gacha_ssr_record where user_id = #{userId}
    </delete>

    <select id="getGfGachaSsrRecordListByUserId" resultType="org.example.xkl_java.bean.GfGachaSsrRecord">
        select * from gf_gacha_ssr_record where user_id = #{userId}
    </select>



    <resultMap id="getGachaItemVOListByUidRM" type="org.example.xkl_java.vo.GachaItemVO">
        <result column="item_id" property="itemId" />
        <result column="item_name" property="itemName" />
        <result column="item_type" property="itemType" />
        <result column="ssr_type" property="ssrType" />
        <result column="cost_draws" property="costDraws" />
        <result column="pool_type" property="poolType" />
        <result column="draw_order" property="drawOrder" />
    </resultMap>
    <select id="getGachaItemVOListByUid" resultMap="getGachaItemVOListByUidRM">
        select COALESCE(i.item_id, r.item_id) as item_id, i.item_name, i.item_type, i.ssr_type, r.cost_draws, r.pool_type, r.draw_order
        from gf_user as u
        left join gf_gacha_ssr_record as r on u.id = r.user_id
        left join gf_ssr_item as i on r.item_id = i.id
        where u.uid = #{uid} and u.is_deleted = 0
        order by r.pool_type, r.draw_order
    </select>
</mapper>